erDiagram
    USERS {
        int id PK
        string email UK
        string name
        timestamp created_at
    }

    BORROWERS {
        int id PK
        int user_id FK, UK
        string card_number UK
        string phone "optional"
        timestamp created_at
    }

    BOOKS {
        int id PK
        string title
        string isbn UK
        int publication_year
        timestamp created_at
    }

    AUTHORS {
        int id PK
        string name
        text bio "optional"
    }

    GENRES {
        int id PK
        string name UK
        text description "optional"
    }

    BOOK_AUTHORS {
        int book_id PK, FK
        int author_id PK, FK
    }

    BOOK_GENRES {
        int book_id PK, FK
        int genre_id PK, FK
    }

    LOANS {
        int id PK
        int borrower_id FK
        int book_id FK
        date loan_date
        date due_date
        date return_date "optional"
        string status
    }

    USERS ||--o| BORROWERS : "extends"
    BORROWERS ||--o{ LOANS : "borrows"
    BOOKS ||--o{ LOANS : "loaned_in"
    BOOKS ||--o{ BOOK_AUTHORS : "has"
    AUTHORS ||--o{ BOOK_AUTHORS : "written_by"
    BOOKS ||--o{ BOOK_GENRES : "categorized_under"
    GENRES ||--o{ BOOK_GENRES : "includes"
